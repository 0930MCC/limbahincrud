# LIMBAHIN — Apache config (Hostinger). Save as  public/.htaccess  in the project so every
# `npm run build` copies it into dist/ automatically (Vite copies public/* to dist/ unchanged).
# It must end up in the SAME folder as index.html and assets/ on the server.
#
# Order matters: redirects first, SPA fallback last.

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # 1) One canonical address: https + www. (Stops http:// and non-www copies being reported as
  #    "Alternate page with proper canonical tag".) Only the exact bare domain is redirected, so
  #    Hostinger preview / temporary URLs keep working.
  RewriteCond %{HTTPS} off
  RewriteCond %{HTTP:X-Forwarded-Proto} !https
  RewriteRule ^ https://www.mediacahayacerah.com%{REQUEST_URI} [L,R=301]

  RewriteCond %{HTTP_HOST} ^mediacahayacerah\.com$ [NC]
  RewriteRule ^ https://www.mediacahayacerah.com%{REQUEST_URI} [L,R=301]

  # 2) No trailing slash: /layanan/partner-klien/ -> /layanan/partner-klien (real folders excluded)
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule ^(.+)/$ /$1 [L,R=301]

  # 3) Old / guessed URLs -> the real page, as a true 301 (so Google drops them instead of
  #    reporting 404). The same redirects also exist inside the React app as a safety net.
  RewriteRule ^partner-klien$             /layanan/partner-klien [L,R=301]
  RewriteRule ^partner$                   /layanan/partner-klien [L,R=301]
  RewriteRule ^klien$                     /layanan/partner-klien [L,R=301]
  RewriteRule ^layanan/partner$           /layanan/partner-klien [L,R=301]
  RewriteRule ^layanan/klien$             /layanan/partner-klien [L,R=301]
  RewriteRule ^layanan/partner-dan-klien$ /layanan/partner-klien [L,R=301]
  RewriteRule ^layanan$                   /layanan/jenis-limbah [L,R=301]
  RewriteRule ^bantuan$                   /bantuan/faq [L,R=301]
  RewriteRule ^jenis-limbah$              /layanan/jenis-limbah [L,R=301]
  RewriteRule ^tentang-kami$              /tentang [L,R=301]
  RewriteRule ^hubungi-kami$              /hubungi [L,R=301]
  RewriteRule ^kontak$                    /hubungi [L,R=301]
  RewriteRule ^faq$                       /bantuan/faq [L,R=301]
  RewriteRule ^karir$                     /bantuan/karir [L,R=301]
  RewriteRule ^harga$                     /harga-limbah [L,R=301]

  # 4) Real files and folders (JS/CSS/images/fonts, sitemap.xml, robots.txt ...) are served as-is.
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # 4b) Legacy .html URLs -> 301 redirect to clean path
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteRule ^(.+)\.html$ /$1 [L,R=301]

  # 5) A missing FILE (anything ending in .js/.css/.png/.xml ...) is a genuine 404. Without this
  #    it would fall through to index.html with status 200 — a "soft 404" that confuses Google
  #    and breaks the app with a confusing error when an old hashed asset has been deleted.
  RewriteCond %{REQUEST_URI} \.[A-Za-z0-9]{2,5}$
  RewriteRule ^ - [R=404,L]

  # 6) Everything else is a React Router page -> index.html (status 200).
  RewriteRule ^ index.html [L]
</IfModule>

# Caching — makes a new deploy show up immediately.
#  * index.html must never be cached: it names the new hashed files (assets/index-XXXX.js).
#  * assets/* have a content hash in the file name, so they can be cached for a year.
<IfModule mod_headers.c>
  <FilesMatch "^index\.html$">
    Header set Cache-Control "no-cache, must-revalidate"
  </FilesMatch>
  <FilesMatch "\.(js|css|woff2?|png|jpe?g|webp|svg|ico)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
</IfModule>
